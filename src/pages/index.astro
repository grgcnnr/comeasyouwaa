---
import Layout from "../Layout.astro"
import headingImg from "../images/heading.svg"
---

<Layout>
  <main>
    <h1>
      <span> Come as you Waa! </span>
    </h1>
  </main>
</Layout>

<style define:vars={{ headingImg: `url(${headingImg.src})` }}>
  main {
    margin-inline: auto;
    max-width: 800px;
  }

  h1 {
    width: 100%;
    aspect-ratio: 1;
    background: var(--headingImg);
    background-position: center center;
    background-size: contain;
    span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }
  }
</style>
